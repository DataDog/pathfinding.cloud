{
  "id": "iam-007",
  "name": "iam:PutUserPolicy",
  "description": "A principal with iam:PutUserPolicy can attach inline policies to any user they have this permission on. This is frequently exploited for self-escalation by granting the caller's own user full administrative access.",
  "category": "self-escalation",
  "services": [
    "iam"
  ],
  "primaryService": "iam",
  "aliases": [
    "iam-putuserpolicy",
    "exploit/iam_putuserpolicy"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/iam-007",
  "permissions": {
    "required": [
      {
        "permission": "iam:PutUserPolicy",
        "description": "Target user must be in Resource section; for self-escalation, must have permission on own user"
      }
    ]
  },
  "prerequisites": {
    "admin": [
      "Principal must be a user (not a role)",
      "User must have iam:PutUserPolicy permission on itself"
    ],
