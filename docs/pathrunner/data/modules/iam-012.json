    },
    {
      "title": "HackingTheCloud - UpdateAssumeRolePolicy Privilege Escalation",
      "url": "https://hackingthe.cloud/aws/exploitation/iam_privilege_escalation/#iamupdateassumerolepolicy"
    }
  ],
  "mitre": {
    "tactics": [
      "TA0004 - Privilege Escalation",
