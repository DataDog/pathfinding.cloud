{
  "id": "iam-012",
  "name": "iam:UpdateAssumeRolePolicy",
  "description": "Anyone with iam:UpdateAssumeRolePolicy can modify the trust policy of any role they have this permission on. This is often abused to modify a privileged role's trust policy to allow the attacker to assume it, even without sts:AssumeRole permission.",
  "category": "principal-access",
  "services": [
    "iam"
  ],
  "primaryService": "iam",
  "aliases": [
    "iam-updateassumerolepolicy",
    "exploit/iam_updateassumerolepolicy"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/iam-012",
  "permissions": {
    "required": [
      {
        "permission": "iam:UpdateAssumeRolePolicy",
        "description": "Target role must be in Resource section"
      }
    ],
    "additional": [
      {
        "permission": "iam:ListRoles",
        "description": "Discover target roles"
      },
      {
        "permission": "iam:GetRole",
        "description": "View role trust policies"
      }
    ]
  },
  "prerequisites": {
    "admin": [
      "Target role must have administrative permissions"
    ]
  },
  "references": [
