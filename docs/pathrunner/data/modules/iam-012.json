    ]
  },
  "options": [
    {
      "name": "TARGET_ROLE",
      "description": "Name of the IAM role to modify trust policy for",
      "required": true,
      "mockValue": "TargetRoleName"
    },
    {
      "name": "TRUST_PRINCIPAL",
      "description": "Principal to trust (role/user ARN, account root ARN, service name). Defaults to current caller",
      "required": false,
      "mockValue": "arn:aws:iam::123456789012:root"
    },
    {
      "name": "ASSUME_ROLE",
      "description": "Attempt to assume the target role after updating trust policy",
      "required": false,
      "default": "true"
    },
    {
      "name": "REGION",
      "description": "AWS region for IAM/STS operations",
      "required": false,
      "default": "us-east-1"
    },
    {
      "name": "AUTO_SWITCH",
      "description": "Automatically switch to new identity after assuming the role",
      "required": false,
      "default": "true"
    }
  ],
  "cliSteps": [
