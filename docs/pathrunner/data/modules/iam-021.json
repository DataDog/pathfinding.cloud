{
  "id": "iam-021",
  "name": "iam:PutRolePolicy + iam:UpdateAssumeRolePolicy",
  "description": "Add an inline policy with admin permissions to a target role and modify its trust policy to allow assumption. When a principal is explicitly named in a trust policy, they can assume the role without separate sts:AssumeRole permissions.",
  "category": "principal-access",
  "services": [
    "iam"
  ],
  "primaryService": "iam",
  "aliases": [
    "iam-putrolepolicy-updateassumerolepolicy",
    "exploit/iam_putrolepolicy_updateassumerolepolicy"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/iam-021",
  "permissions": {
    "required": [
      {
        "permission": "iam:PutRolePolicy",
        "description": "Must have permission to add inline policies to the target role"
      },
      {
        "permission": "iam:UpdateAssumeRolePolicy",
        "description": "Must have permission to modify the trust policy of the target role"
      }
    ],
    "additional": [
      {
        "permission": "iam:ListRoles",
        "description": "Discover available roles"
      },
      {
        "permission": "iam:GetRole",
        "description": "View role trust policies"
      }
    ]
  },
