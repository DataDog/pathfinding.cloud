{
  "id": "sts-001",
  "name": "sts:AssumeRole",
  "description": "Assume an IAM role using current credentials and switch to the new identity",
  "category": "principal-access",
  "services": [
    "sts"
  ],
  "primaryService": "sts",
  "aliases": [
    "sts-assume-role",
    "exploit/sts_assume_role"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/sts-001",
  "permissions": {
    "required": [
      {
        "permission": "sts:AssumeRole",
        "description": "Target role ARN"
      }
    ]
  },
  "prerequisites": {
    "admin": [
      "Target role with trust policy allowing the calling principal"
    ],
    "lateral": [
      "Principal with sts:AssumeRole on the target role"
    ]
  },
  "references": [
    {
      "title": "Pathfinding Cloud - sts-001",
      "url": "https://pathfinding.cloud/paths/sts-001"
    }
  ],
  "mitre": {
    "tactics": [
      "TA0004 - Privilege Escalation",
      "TA0008 - Lateral Movement"
    ],
    "techniques": [
      "T1078.004 - Valid Accounts: Cloud Accounts"
    ]
  },
  "options": [
    {
      "name": "ROLE_ARN",
      "description": "Target IAM role ARN to assume",
      "required": true,
      "mockValue": "arn:aws:iam::123456789012:role/TargetRoleName"
    },
    {
      "name": "SESSION_NAME",
      "description": "Session name for the assumed role",
      "required": false,
      "default": "pathrunner-session",
      "mockValue": "target-resource-name"
    },
    {
      "name": "EXTERNAL_ID",
      "description": "External ID if required by the role's trust policy",
      "required": false,
      "mockValue": "target-resource-id"
    },
    {
      "name": "DURATION",
      "description": "Session duration in seconds (900-43200, default 3600)",
      "required": false,
      "default": "3600"
    },
    {
      "name": "REGION",
      "description": "AWS region for STS operations",
      "required": false,
      "default": "us-east-1"
    },
    {
      "name": "IDENTITY_NAME",
      "description": "Name for the new identity (auto-generated if not provided)",
      "required": false,
      "mockValue": "target-resource-name"
    },
    {
      "name": "AUTO_SWITCH",
      "description": "Automatically switch to new identity after successful assumption",
      "required": false,
      "default": "true"
    }
  ],
  "cliSteps": [
    "pathrunner use sts-001",
    "pathrunner set ROLE_ARN arn:aws:iam::123456789012:role/TargetRoleName",
    "pathrunner exploit"
  ],
  "labSlug": "sts-001",
  "gifs": [
