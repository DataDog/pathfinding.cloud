{
  "id": "iam-020",
  "name": "iam:CreatePolicyVersion + iam:UpdateAssumeRolePolicy",
  "description": "Create a new version of a customer-managed policy with admin permissions and update the target role's trust policy to allow assumption. Does not require sts:AssumeRole permission beforehand.",
  "category": "principal-access",
  "services": [
    "iam"
  ],
  "primaryService": "iam",
  "aliases": [
    "iam-createpolicyversion-updateassumerolepolicy",
    "exploit/iam_createpolicyversion_updateassumerolepolicy"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/iam-020",
  "permissions": {
    "required": [
      {
        "permission": "iam:CreatePolicyVersion",
        "description": "Must have permission to create new versions of the target policy"
      },
      {
        "permission": "iam:UpdateAssumeRolePolicy",
        "description": "Must have permission to modify the trust policy of the target role"
      }
    ],
    "additional": [
      {
        "permission": "iam:ListRoles",
        "description": "Discover available roles"
      },
      {
        "permission": "iam:GetRole",
        "description": "View role trust policies"
      },
      {
        "permission": "iam:ListPolicyVersions",
        "description": "List existing policy versions"
      }
    ]
  },
  "prerequisites": {
    "admin": [
      "A customer-managed policy must be attached to the target role"
    ]
  },
  "references": [
    {
      "title": "Pathfinding Cloud - iam-020",
      "url": "https://pathfinding.cloud/paths/iam-020"
    },
    {
      "title": "HackTricks - AWS - IAM Privesc",
      "url": "https://cloud.hacktricks.wiki/en/pentesting-cloud/aws-security/aws-privilege-escalation/aws-iam-privesc/index.html#iamupdateassumerolepolicy"
    }
  ],
  "relatedPaths": [
    "iam-001",
    "iam-002",
    "iam-009",
    "iam-014"
  ],
  "mitre": {
    "tactics": [
      "TA0004 - Privilege Escalation",
      "TA0008 - Lateral Movement"
    ],
    "techniques": [
      "T1098 - Account Manipulation"
    ]
  },
  "options": [
    {
      "name": "POLICY_ARN",
      "description": "ARN of the customer-managed policy to create a new version of",
      "required": true,
      "mockValue": "arn:aws:iam::123456789012:policy/TargetPolicy"
    },
    {
      "name": "TARGET_ROLE",
      "description": "Name of the IAM role to update trust policy for and assume",
      "required": true,
      "mockValue": "TargetRoleName"
    },
    {
      "name": "REGION",
      "description": "AWS region for IAM/STS operations",
      "required": false,
      "default": "us-east-1"
    },
    {
      "name": "AUTO_SWITCH",
      "description": "Automatically switch to new identity after assuming the role",
      "required": false,
      "default": "true"
    }
  ],
  "cliSteps": [
    "pathrunner use iam-020",
    "pathrunner set POLICY_ARN arn:aws:iam::123456789012:policy/TargetPolicy",
    "pathrunner set TARGET_ROLE TargetRoleName",
    "pathrunner exploit"
  ],
  "labSlug": "iam-020",
