{
  "id": "iam-019",
  "name": "iam:AttachRolePolicy + iam:UpdateAssumeRolePolicy",
  "description": "Attach an admin managed policy to a target role and modify its trust policy to allow the attacker to assume it. Does NOT require pre-existing sts:AssumeRole permission \u2014 being explicitly named in the trust policy grants assumption ability.",
  "category": "principal-access",
  "services": [
    "iam"
  ],
  "primaryService": "iam",
  "aliases": [
    "iam-attachrolepolicy-updateassumerolepolicy",
    "exploit/iam_attachrolepolicy_updateassumerolepolicy"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/iam-019",
  "permissions": {
    "required": [
      {
        "permission": "iam:AttachRolePolicy",
        "description": "Must have permission to attach policies to the target role"
      },
      {
        "permission": "iam:UpdateAssumeRolePolicy",
        "description": "Must have permission to modify the trust policy of the target role"
      }
    ],
    "additional": [
      {
        "permission": "iam:ListRoles",
        "description": "Discover available roles"
      },
      {
        "permission": "iam:GetRole",
        "description": "View role trust policies"
      }
    ]
  },
  "prerequisites": {
    "admin": [
      "An administrative managed policy must exist to attach (e.g., AdministratorAccess)"
    ]
  },
  "references": [
    {
      "title": "Pathfinding Cloud - iam-019",
      "url": "https://pathfinding.cloud/paths/iam-019"
    },
    {
      "title": "HackTricks - AWS - IAM Privesc",
      "url": "https://cloud.hacktricks.wiki/en/pentesting-cloud/aws-security/aws-privilege-escalation/aws-iam-privesc/index.html#iamupdateassumerolepolicy"
    }
  ],
  "mitre": {
    "tactics": [
      "TA0004 - Privilege Escalation",
      "TA0008 - Lateral Movement"
    ],
    "techniques": [
      "T1098 - Account Manipulation"
    ]
  },
  "options": [
    {
      "name": "TARGET_ROLE",
      "description": "Name of the IAM role to escalate and assume",
      "required": true,
      "mockValue": "TargetRoleName"
    },
    {
      "name": "POLICY_ARN",
      "description": "ARN of the managed policy to attach (defaults to AdministratorAccess)",
      "required": false,
      "default": "arn:aws:iam::aws:policy/AdministratorAccess",
      "mockValue": "arn:aws:iam::123456789012:policy/TargetPolicy"
    },
    {
      "name": "REGION",
      "description": "AWS region for IAM/STS operations",
      "required": false,
      "default": "us-east-1"
    },
    {
      "name": "AUTO_SWITCH",
      "description": "Automatically switch to new identity after assuming the role",
      "required": false,
      "default": "true"
    }
  ],
  "cliSteps": [
    "pathrunner use iam-019",
    "pathrunner set TARGET_ROLE TargetRoleName",
    "pathrunner exploit"
  ],
  "labSlug": "iam-019",
