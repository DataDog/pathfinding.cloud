{
  "id": "ecs-003",
  "name": "iam:PassRole + ecs:RegisterTaskDefinition + ecs:CreateService",
  "description": "Register an ECS task definition with a privileged role and launch it as a Fargate service to execute code with the role's permissions",
  "category": "new-passrole",
  "services": [
    "iam",
    "ecs"
  ],
  "primaryService": "ecs",
  "aliases": [
    "ecs-passrole-createservice",
    "exploit/ecs_passrole_createservice"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/ecs-003",
  "permissions": {
    "required": [
      {
        "permission": "iam:PassRole",
        "description": "Target role ARN that trusts ecs-tasks.amazonaws.com"
      },
      {
        "permission": "ecs:RegisterTaskDefinition"
      },
      {
        "permission": "ecs:CreateService"
      }
    ],
    "additional": [
      {
        "permission": "ec2:DescribeVpcs",
        "description": "Auto-detect default VPC"
      },
      {
        "permission": "ec2:DescribeSubnets",
        "description": "Auto-detect subnet for Fargate"
      },
      {
        "permission": "ecs:ListClusters",
        "description": "Discover available ECS clusters"
      },
      {
        "permission": "ecs:DescribeServices",
        "description": "Monitor service status"
      },
      {
        "permission": "ecs:DescribeTasks",
        "description": "Monitor task execution"
      },
      {
        "permission": "ecs:ListTasks",
        "description": "List tasks in service"
      },
      {
        "permission": "iam:ListRoles",
        "description": "Discover passable roles"
      }
    ]
  },
  "prerequisites": {
    "admin": [
      "An ECS cluster must exist in the account",
      "A role must exist that trusts ecs-tasks.amazonaws.com with desired permissions"
    ],
    "lateral": [
      "Principal with iam:PassRole, ecs:RegisterTaskDefinition, and ecs:CreateService"
    ]
  },
  "references": [
    {
      "title": "Pathfinding Cloud - ecs-003",
      "url": "https://pathfinding.cloud/paths/ecs-003"
    }
  ],
  "mitre": {
    "tactics": [
      "TA0004 - Privilege Escalation",
      "TA0002 - Execution"
    ],
    "techniques": [
      "T1078.004 - Valid Accounts: Cloud Accounts",
      "T1610 - Deploy Container"
    ]
  },
  "options": [
    {
      "name": "ROLE_ARN",
      "description": "Target IAM role ARN to pass to the ECS task (must trust ecs-tasks.amazonaws.com)",
      "required": true,
      "mockValue": "arn:aws:iam::123456789012:role/TargetRoleName"
    },
    {
      "name": "CLUSTER_ARN",
      "description": "ECS cluster ARN or name to create the service on",
      "required": true,
      "mockValue": "arn:aws:ecs::123456789012:cluster/target-ecs-cluster"
    },
    {
      "name": "PAYLOAD",
      "description": "Payload type (backdoor/attach-policy)",
      "required": true
    },
    {
      "name": "REGION",
      "description": "AWS region for ECS deployment",
      "required": false,
      "default": "us-east-1"
    },
    {
      "name": "SUBNET_ID",
      "description": "Subnet ID for Fargate task networking (auto-detects default VPC if not set)",
      "required": false,
      "mockValue": "subnet-0123456789abcdef0"
    },
    {
      "name": "TASK_FAMILY",
      "description": "ECS task definition family name",
      "required": false
    },
    {
      "name": "SERVICE_NAME",
      "description": "ECS service name",
      "required": false,
      "mockValue": "target-resource-name"
    },
    {
      "name": "CONTAINER_IMAGE",
      "description": "Container image for the task (default: amazon/aws-cli:latest)",
      "required": false,
      "default": "amazon/aws-cli:latest"
    },
    {
      "name": "CLEANUP",
      "description": "Clean up ECS service and task definition after execution",
      "required": false,
      "default": "true"
    }
  ],
  "payloads": [
    {
      "name": "backdoor/attach-policy",
      "description": "Attach AdministratorAccess policy to an IAM user or role via ECS task container command",
      "slug": "ecs-backdoor-attach-policy",
      "qualifiedName": "ecs:backdoor/attach-policy",
      "service": "ecs",
      "tags": [
        "ecs",
        "bash",
        "backdoor"
      ]
    }
  ],
  "cliSteps": [
    "pathrunner use ecs-003",
    "pathrunner show payloads",
    "pathrunner set PAYLOAD backdoor/attach-policy",
    "pathrunner set ROLE_ARN arn:aws:iam::123456789012:role/TargetRoleName",
    "pathrunner set CLUSTER_ARN arn:aws:ecs::123456789012:cluster/target-ecs-cluster",
    "pathrunner set TARGET_ARN arn:aws:iam::123456789012:role/TargetRoleName",
    "pathrunner exploit"
  ],
  "labSlug": "ecs-003",
  "gifs": [
    {
      "name": "ecs-003",
      "ext": "webm"
    }
  ]
}