{
  "id": "iam-018",
  "name": "iam:PutUserPolicy + iam:CreateAccessKey",
  "description": "Add an inline policy with admin permissions to a target user, then create access keys for that user. Unlike managed policy attachment, inline policies are embedded directly in the user object and are less visible in some security reviews.",
  "category": "principal-access",
  "services": [
    "iam"
  ],
  "primaryService": "iam",
  "aliases": [
    "iam-putuserpolicy-createaccesskey",
    "exploit/iam_putuserpolicy_createaccesskey"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/iam-018",
  "permissions": {
    "required": [
      {
        "permission": "iam:PutUserPolicy",
        "description": "Must have access to add inline policies to the target user"
      },
      {
        "permission": "iam:CreateAccessKey",
        "description": "Must have permission to create access keys for the target user"
      }
    ],
    "additional": [
      {
        "permission": "iam:ListUsers",
        "description": "Discover available users"
      },
      {
        "permission": "iam:ListAccessKeys",
        "description": "Check existing access key count"
      }
    ]
  },
  "prerequisites": {
    "admin": [
      "Target user must have fewer than 2 access keys (AWS limit)"
    ],
    "lateral": [
      "Target user must have fewer than 2 access keys (AWS limit)"
    ]
  },
