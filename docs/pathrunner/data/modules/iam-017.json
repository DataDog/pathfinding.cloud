{
  "id": "iam-017",
  "name": "iam:PutRolePolicy + sts:AssumeRole",
  "description": "Add an inline policy with admin permissions to a target role, then assume that role. The target role must have a trust policy allowing assumption. Inline policies are embedded directly in IAM roles and are often overlooked in security reviews.",
  "category": "principal-access",
  "services": [
    "iam",
    "sts"
  ],
  "primaryService": "iam",
  "aliases": [
    "iam-putrolepolicy-assumerole",
    "exploit/iam_putrolepolicy_assumerole"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/iam-017",
  "permissions": {
    "required": [
      {
        "permission": "iam:PutRolePolicy",
        "description": "Must have permission on the target role ARN"
      },
      {
        "permission": "sts:AssumeRole",
        "description": "Must have permission to assume the target role"
      }
    ],
    "additional": [
      {
        "permission": "iam:ListRoles",
        "description": "Discover available roles"
      },
      {
        "permission": "iam:GetRole",
        "description": "View role trust policies"
      }
    ]
  },
  "prerequisites": {
    "admin": [
      "Target role's trust policy must allow your principal to assume it"
    ],
