{
  "id": "iam-002",
  "name": "iam:CreateAccessKey",
  "description": "Create access keys for a target IAM user to gain their permissions. Anyone with iam:CreateAccessKey on a target user can generate new credentials and authenticate as that user.",
  "category": "principal-access",
  "services": [
    "iam"
  ],
  "primaryService": "iam",
  "aliases": [
    "iam-createaccesskey",
    "exploit/iam_createaccesskey"
  ],
  "author": "Seth Art",
  "pathfindingCloudUrl": "https://pathfinding.cloud/paths/iam-002",
  "permissions": {
    "required": [
      {
        "permission": "iam:CreateAccessKey",
        "description": "Target IAM user must be in the Resource section"
      }
    ],
    "additional": [
      {
        "permission": "iam:ListUsers",
        "description": "Helpful for discovering target users"
      },
      {
        "permission": "iam:GetUser",
        "description": "Useful for viewing user details"
      },
      {
        "permission": "iam:ListAttachedUserPolicies",
        "description": "Identify users with admin permissions"
      }
    ]
  },
