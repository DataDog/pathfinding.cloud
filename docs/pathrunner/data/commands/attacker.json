{
  "name": "attacker",
  "path": "pathrunner attacker",
  "group": "core",
  "short": "Manage attacker account identity",
  "long": "Configure an attacker-controlled AWS account for deploying resources used during exploitation",
  "usage": "pathrunner attacker",
  "subcommands": [
    {
      "name": "clear",
      "path": "pathrunner attacker clear",
      "short": "Remove attacker identity (alias for 'attacker identity remove')",
      "usage": "pathrunner attacker clear"
    },
    {
      "name": "identity",
      "path": "pathrunner attacker identity",
      "short": "Manage attacker identity",
      "usage": "pathrunner attacker identity",
      "subcommands": [
        {
          "name": "add",
          "path": "pathrunner attacker identity add",
          "short": "Configure attacker identity credentials",
          "usage": "pathrunner attacker identity add",
          "subcommands": [
            {
              "name": "keys",
              "path": "pathrunner attacker identity add keys",
              "short": "Configure from access keys",
              "usage": "pathrunner attacker identity add keys [flags]",
              "flags": [
                {
                  "name": "access",
                  "usage": "AWS access key ID",
                  "type": "string"
                },
                {
                  "name": "region",
                  "usage": "AWS region (default: us-east-1)",
                  "type": "string"
                },
                {
                  "name": "secret",
                  "usage": "AWS secret access key",
                  "type": "string"
                },
                {
                  "name": "token",
                  "usage": "AWS session token (optional)",
                  "type": "string"
                }
              ]
            },
            {
              "name": "profile",
              "path": "pathrunner attacker identity add profile",
              "short": "Configure from AWS profile",
              "usage": "pathrunner attacker identity add profile [name]"
            }
          ]
        },
        {
          "name": "remove",
          "path": "pathrunner attacker identity remove",
          "short": "Remove attacker identity",
          "usage": "pathrunner attacker identity remove"
        },
        {
          "name": "show",
          "path": "pathrunner attacker identity show",
          "short": "Show current attacker identity",
          "usage": "pathrunner attacker identity show"
        },
        {
          "name": "validate",
          "path": "pathrunner attacker identity validate",
          "short": "Validate attacker credentials",
          "usage": "pathrunner attacker identity validate"
        }
      ]
    },
    {
      "name": "infra",
      "path": "pathrunner attacker infra",
      "short": "Manage attacker infrastructure",
