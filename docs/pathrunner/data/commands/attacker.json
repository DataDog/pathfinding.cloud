              "usage": "Credential collection port (default: 8443)",
              "default": "0",
              "type": "int"
            },
            {
              "name": "public-ip",
              "usage": "Override auto-detected public IP",
              "type": "string"
            },
            {
              "name": "shell-port",
              "usage": "Reverse shell port (default: 4444)",
              "default": "0",
              "type": "int"
            }
          ]
        },
        {
          "name": "status",
          "path": "pathrunner attacker listener status",
          "short": "Show listener state and statistics",
          "usage": "pathrunner attacker listener status"
        },
        {
          "name": "stop",
          "path": "pathrunner attacker listener stop",
          "short": "Stop the listener",
          "usage": "pathrunner attacker listener stop"
        }
