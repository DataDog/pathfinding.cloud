        {
          "name": "log",
          "path": "pathrunner attacker listener log",
          "short": "Show recent listener events",
          "usage": "pathrunner attacker listener log [flags]",
          "flags": [
            {
              "name": "count",
              "usage": "Number of recent events to show",
              "default": "50",
              "type": "int"
            }
          ]
        },
        {
          "name": "start",
          "path": "pathrunner attacker listener start",
          "short": "Start the unified listener (HTTPS creds + TLS shells)",
          "usage": "pathrunner attacker listener start [flags]",
          "flags": [
            {
              "name": "host",
