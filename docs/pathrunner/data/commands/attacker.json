      "usage": "pathrunner attacker infra",
      "subcommands": [
        {
          "name": "bucket",
          "path": "pathrunner attacker infra bucket",
          "short": "Manage S3 bucket deployments",
          "usage": "pathrunner attacker infra bucket",
          "subcommands": [
            {
              "name": "create",
              "path": "pathrunner attacker infra bucket create",
              "short": "Create an S3 bucket for code hosting or exfiltration",
              "usage": "pathrunner attacker infra bucket create [flags]",
              "flags": [
                {
                  "name": "region",
                  "usage": "AWS region for the bucket",
                  "type": "string"
                },
                {
                  "name": "type",
                  "usage": "Bucket type: code or exfil (default: exfil)",
                  "type": "string"
                }
              ]
            },
            {
              "name": "destroy",
              "path": "pathrunner attacker infra bucket destroy",
              "short": "Destroy deployed bucket(s)",
              "usage": "pathrunner attacker infra bucket destroy [flags]",
              "flags": [
                {
                  "name": "name",
                  "usage": "Specific bucket name to destroy (destroys all if omitted)",
                  "type": "string"
                }
              ]
            },
            {
              "name": "status",
              "path": "pathrunner attacker infra bucket status",
              "short": "Show deployed buckets",
              "usage": "pathrunner attacker infra bucket status"
            }
          ]
        },
        {
