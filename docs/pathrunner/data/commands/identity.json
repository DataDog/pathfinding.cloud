{
  "name": "identity",
  "path": "pathrunner identity",
  "group": "core",
  "short": "Manage AWS identities",
  "long": "Add, list, switch, and manage AWS credential identities",
  "usage": "pathrunner identity",
  "subcommands": [
    {
      "name": "add",
      "path": "pathrunner identity add",
      "short": "Add AWS identity",
      "long": "Add AWS identity from environment, profile, keys, file, clipboard, or exploit output",
      "usage": "pathrunner identity add [flags]",
      "flags": [
        {
          "name": "access",
          "usage": "Access key ID (requires --secret)",
          "type": "string"
        },
        {
          "name": "check-admin",
          "usage": "Auto-check admin privileges after adding",
          "default": "false",
          "type": "bool"
        },
        {
          "name": "from-clipboard",
          "usage": "Read credentials from clipboard or stdin",
          "default": "false",
          "type": "bool"
        },
        {
          "name": "from-file",
          "usage": "Read credentials from file",
          "type": "string"
        },
        {
          "name": "from-output",
          "usage": "Extract credentials from last exploit output",
          "default": "false",
          "type": "bool"
        },
        {
          "name": "from-profile",
          "usage": "AWS profile name (alias for --profile)",
          "type": "string"
        },
        {
          "name": "name",
          "usage": "Custom name for the identity",
          "type": "string"
        },
        {
          "name": "profile",
          "usage": "AWS profile name",
          "type": "string"
        },
        {
          "name": "secret",
          "usage": "Secret access key",
          "type": "string"
        },
        {
          "name": "switch",
          "usage": "Auto-switch to the new identity without prompting",
          "default": "false",
          "type": "bool"
        },
        {
          "name": "token",
          "usage": "Session token (optional)",
          "type": "string"
        }
      ]
    },
    {
      "name": "check",
      "path": "pathrunner identity check",
      "short": "Check if identity has admin privileges",
      "long": "Uses IAM Policy Simulator to test whether an identity has admin-level access",
      "usage": "pathrunner identity check [name]"
    },
    {
      "name": "clear",
      "path": "pathrunner identity clear",
      "short": "Remove identity or clear expired identities",
      "long": "Remove a specific identity by name, or use --expired to remove all expired identities",
      "usage": "pathrunner identity clear [identity-name] [flags]",
      "aliases": [
        "remove"
      ],
      "flags": [
        {
          "name": "expired",
          "usage": "Remove all expired identities",
          "default": "false",
          "type": "bool"
        }
      ]
    },
    {
      "name": "current",
      "path": "pathrunner identity current",
      "short": "Show current identity details",
      "usage": "pathrunner identity current"
    },
    {
      "name": "list",
      "path": "pathrunner identity list",
      "short": "List all configured identities",
      "usage": "pathrunner identity list"
    },
    {
      "name": "refresh",
      "path": "pathrunner identity refresh",
      "short": "Refresh current identity credentials",
      "usage": "pathrunner identity refresh"
    },
    {
      "name": "show",
      "path": "pathrunner identity show",
      "short": "Show current identity details",
      "usage": "pathrunner identity show"
    },
    {
      "name": "switch",
      "path": "pathrunner identity switch",
      "short": "Switch to different identity",
      "usage": "pathrunner identity switch <name>"
    }
  ],
  "gifs": [
    "identity-current",
    "identity-list",
    "identity-show",
    "identity-switch"
  ]
}