{
  "name": "workspace",
  "path": "pathrunner workspace",
  "group": "core",
  "short": "Manage pathrunner workspaces",
  "long": "Create, switch, save, delete, and manage pathrunner workspaces",
  "usage": "pathrunner workspace",
  "subcommands": [
    {
      "name": "cleanup",
      "path": "pathrunner workspace cleanup",
      "short": "Clean up AWS resources in current workspace",
      "usage": "pathrunner workspace cleanup [flags]",
      "flags": [
        {
          "name": "all",
          "usage": "Clean up all resources without interactive prompt",
          "default": "false",
          "type": "bool"
        },
        {
          "name": "module",
          "usage": "Only clean up resources created by a specific module ID",
          "type": "string"
        },
        {
          "name": "yes",
          "shorthand": "y",
          "usage": "Skip interactive confirmation prompt",
          "default": "false",
          "type": "bool"
        }
      ]
    },
    {
      "name": "create",
      "path": "pathrunner workspace create",
      "short": "Create new workspace",
      "usage": "pathrunner workspace create <name>"
    },
    {
      "name": "delete",
      "path": "pathrunner workspace delete",
      "short": "Delete workspace",
      "usage": "pathrunner workspace delete <name>"
    },
    {
      "name": "history",
      "path": "pathrunner workspace history",
      "short": "Show command history with timestamps",
      "usage": "pathrunner workspace history"
    },
    {
      "name": "list",
      "path": "pathrunner workspace list",
      "short": "List all workspaces",
      "usage": "pathrunner workspace list"
    },
    {
      "name": "report",
      "path": "pathrunner workspace report",
      "short": "Generate cleanup report for handoff to client/admin",
      "usage": "pathrunner workspace report [flags]",
      "flags": [
        {
          "name": "module",
          "usage": "Only report resources from a specific module ID",
          "type": "string"
        },
        {
          "name": "output",
          "shorthand": "o",
          "usage": "Write report to file (format inferred from extension: .html or .md)",
          "type": "string"
        }
      ]
    },
    {
      "name": "save",
      "path": "pathrunner workspace save",
      "short": "Save current workspace state",
      "usage": "pathrunner workspace save"
    },
    {
      "name": "switch",
      "path": "pathrunner workspace switch",
      "short": "Switch to different workspace",
      "usage": "pathrunner workspace switch <name>"
    }
  ],
  "gifs": [
    "workspace-create",
