{
  "name": "modules",
  "path": "pathrunner modules",
  "group": "core",
  "short": "List and search modules",
  "usage": "pathrunner modules",
  "subcommands": [
    {
      "name": "list",
      "path": "pathrunner modules list",
      "short": "List all available modules",
      "usage": "pathrunner modules list [flags]",
      "flags": [
        {
          "name": "wide",
          "usage": "Include description column",
          "default": "false",
          "type": "bool"
        }
      ]
    },
    {
      "name": "mark-results",
      "path": "pathrunner modules mark-results",
      "short": "Record per-payload test results for a module",
      "usage": "pathrunner modules mark-results <module-id> <scenario-id> <results-json-file>"
    },
    {
      "name": "mark-status",
      "path": "pathrunner modules mark-status",
      "short": "Set module test status (tested|untested|failing|needs-update)",
      "usage": "pathrunner modules mark-status <module-id> <status>"
    },
    {
      "name": "mark-tested",
      "path": "pathrunner modules mark-tested",
      "short": "Mark a module as tested",
      "usage": "pathrunner modules mark-tested <module-id> [lab-name]"
    },
    {
      "name": "search",
      "path": "pathrunner modules search",
      "short": "Search modules by keyword",
      "usage": "pathrunner modules search <query>"
    },
    {
      "name": "status",
      "path": "pathrunner modules status",
      "short": "Show test status for modules",
      "usage": "pathrunner modules status [module-id]"
    },
    {
      "name": "summary",
      "path": "pathrunner modules summary",
      "short": "Show module count by service",
      "usage": "pathrunner modules summary"
    }
  ],
  "gifs": [
    "modules-info",
    "modules-list",
    "modules-status",
    "modules-summary"
  ]
}