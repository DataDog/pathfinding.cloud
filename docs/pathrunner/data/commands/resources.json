{
  "name": "resources",
  "path": "pathrunner resources",
  "group": "core",
  "short": "List and explore imported AWS resources",
  "long": "View AWS resources imported from cloudfox output",
  "usage": "pathrunner resources",
  "subcommands": [
    {
      "name": "clear",
      "path": "pathrunner resources clear",
      "short": "Remove imported resources from the resource store",
      "usage": "pathrunner resources clear [flags]",
      "flags": [
        {
          "name": "account",
          "usage": "Clear resources for a specific AWS account ID",
          "type": "string"
        },
        {
          "name": "all",
          "usage": "Clear all imported resources",
          "default": "false",
          "type": "bool"
        }
      ]
    },
    {
      "name": "import",
      "path": "pathrunner resources import",
      "short": "Import cloudfox output data (alias for 'cloudfox import')",
      "usage": "pathrunner resources import [flags]",
      "flags": [
        {
          "name": "path",
          "usage": "Cloudfox output directory path",
          "type": "string"
        }
      ]
    },
    {
      "name": "list",
      "path": "pathrunner resources list",
      "short": "List imported resources, optionally filtered by service",
      "usage": "pathrunner resources list [service] [flags]",
      "flags": [
        {
          "name": "account",
          "usage": "AWS account ID",
          "type": "string"
        },
        {
          "name": "wide",
          "usage": "Show ARN and type columns",
          "default": "false",
          "type": "bool"
        }
      ]
    },
    {
      "name": "status",
      "path": "pathrunner resources status",
      "short": "Show import status",
      "usage": "pathrunner resources status"
    },
    {
      "name": "summary",
      "path": "pathrunner resources summary",
      "short": "Show resource counts by service and region",
      "usage": "pathrunner resources summary [flags]",
      "flags": [
        {
          "name": "account",
          "usage": "AWS account ID",
          "type": "string"
        }
      ]
    }
  ],
  "gifs": []
}